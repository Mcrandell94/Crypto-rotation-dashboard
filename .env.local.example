# Copy this file to .env.local for local testing and fill in your real keys.
# NEVER commit .env.local to git - it's already excluded in .gitignore below.
# In production (Vercel), these are set instead under:
#   Project Settings > Environment Variables

CMC_API_KEY=your-coinmarketcap-api-key-here

# Free Demo key from CoinGecko (coingecko.com > Developer Dashboard). Powers
# the Relative Rotation Graph's historical price data.
COINGECKO_API_KEY=your-coingecko-demo-api-key-here
